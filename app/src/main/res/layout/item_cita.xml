<?xml version="1.0" encoding="utf-8"?>
<!--
    HU 2.0 - Item de la lista del Home.
    Debajo hay un marcador de MaterialCardView circular para el avatar: el contenido
    visual definitivo (avatar con Glide, jerarquia y estilos) es de la subtarea
    "Item de la lista" y se reemplaza sin tocar el Adapter ni el ViewHolder.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCita"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivMascota"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/item_cita_avatar_description"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_dog_head" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvNombreMascota"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardAvatar"
            app:layout_constraintTop_toTopOf="@id/cardAvatar"
            tools:text="Luna" />

        <TextView
            android:id="@+id/tvSintoma"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvNombreMascota"
            app:layout_constraintTop_toBottomOf="@id/tvNombreMascota"
            tools:text="Cojera de la pata trasera derecha" />

        <TextView
            android:id="@+id/tvTurno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            app:layout_constraintStart_toStartOf="@id/tvNombreMascota"
            app:layout_constraintTop_toBottomOf="@id/tvSintoma"
            tools:text="Turno #3" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
