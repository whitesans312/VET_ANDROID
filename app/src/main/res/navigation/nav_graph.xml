<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.dogapp.view.login.LoginFragment"
        android:label="@string/login_title">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.dogapp.view.home.HomeFragment"
        android:label="@string/home_title" />

    <fragment
        android:id="@+id/detalleCitaFragment"
        android:name="com.example.dogapp.view.detalle.DetalleCitaFragment"
        android:label="Detalle Cita" />

    <fragment
        android:id="@+id/editarCitaFragment"
        android:name="com.example.dogapp.view.editarcita.EditarCitaFragment"
        android:label="Editar Cita" />

</navigation>
